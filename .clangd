CompileFlags:
  CompilationDatabase: build
  Add:
    # 项目自身
    - -I/home/lsy/cs_project/aurora/src
    - -I/home/lsy/cs_project/aurora/src/auto_sentry
    - -I/home/lsy/cs_project/aurora/src/mapper/src
    - -I/home/lsy/cs_project/aurora/src/party/mine/logger/src
    # 构建期生成的 spdlog
    - -isystem/home/lsy/cs_project/aurora/build/spdlog-prefix/include
    # 标准第三方
    - -isystem/usr/include/eigen3
    - -isystem/usr/include/pcl-1.12
    - -isystem/usr/include/opencv4
    - -isystem/usr/include/ceres
    - -isystem/usr/include/yaml-cpp
    - -isystem/usr/include/tbb
    # ROS 2 Humble
    - -isystem/opt/ros/humble/include/rclcpp
